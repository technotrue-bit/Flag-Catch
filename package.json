{
  "name": "flag-catch",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "FLAG CATCH: a fast, colorful 3D capture the flag game for TrueAIGaming.com. Phone first, landscape.",
  "scripts": {
    "dev": "vite --port 5181 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:portal": "tsc --noEmit && VITE_PORTAL=1 vite build --outDir dist-portal",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 5181 --strictPort",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/realtime-js": "2.118.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "3.2.4"
  }
}
